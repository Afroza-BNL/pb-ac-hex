// Use if motor voltage >= bus voltage
Motor[1].PwmSf = 0.95 * 16384
Motor[2].PwmSf = 0.95 * 16384
Motor[3].PwmSf = 0.95 * 16384
Motor[4].PwmSf = 0.95 * 16384


