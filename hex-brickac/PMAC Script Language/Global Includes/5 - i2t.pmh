// For RMS values
GLOBAL ChMaxAdc		= 25.0;		// Max ADC reading [A peak] for 8A/16A model
GLOBAL ChTimeAtPeak = 1;			// Time Allowed at peak [sec] --User Input

GLOBAL Ch1RmsPeakCur = 3.2;			// RMS Peak Current [A rms] -–User Input
GLOBAL Ch1RmsContCur = 2.5;			// RMS Continuous Current [A rms] --User Input

GLOBAL Ch2RmsPeakCur = 0.5;			// RMS Peak Current [A rms] -–User Input
GLOBAL Ch2RmsContCur = 0.2;			// RMS Continuous Current [A rms] --User Input

GLOBAL Ch3RmsPeakCur = 0.5;			// RMS Peak Current [A rms] -–User Input
GLOBAL Ch3RmsContCur = 0.2;			// RMS Continuous Current [A rms] --User Input

GLOBAL Ch4RmsPeakCur = 0.5;			// RMS Peak Current [A rms] -–User Input
GLOBAL Ch4RmsContCur = 0.2;			// RMS Continuous Current [A rms] --User Input

// 3 phase servo
Motor[1].MaxDac = Ch1RmsPeakCur / ChMaxAdc * 32767 * 0.866
Motor[1].I2TSet = Ch1RmsContCur / ChMaxAdc * 32767 * 0.866
Motor[1].I2tTrip = (POW(Motor[1].MaxDac,2) - POW(Motor[1].I2TSet,2)) * ChTimeAtPeak
Motor[1].IdCmd = 0

// 3 phase servo
Motor[2].MaxDac = Ch2RmsPeakCur / ChMaxAdc * 32767 * 0.866
Motor[2].I2TSet = Ch2RmsContCur / ChMaxAdc * 32767 * 0.866
Motor[2].I2tTrip = (POW(Motor[2].MaxDac,2) - POW(Motor[2].I2TSet,2)) * ChTimeAtPeak
Motor[2].IdCmd = 0

// 3 phase servo
Motor[3].MaxDac = Ch3RmsPeakCur / ChMaxAdc * 32767 * 0.866
Motor[3].I2TSet = Ch3RmsContCur / ChMaxAdc * 32767 * 0.866
Motor[3].I2tTrip = (POW(Motor[3].MaxDac,2) - POW(Motor[3].I2TSet,2)) * ChTimeAtPeak
Motor[3].IdCmd = 0

// 3 phase servo
Motor[4].MaxDac = Ch4RmsPeakCur / ChMaxAdc * 32767 * 0.866
Motor[4].I2TSet = Ch4RmsContCur / ChMaxAdc * 32767 * 0.866
Motor[4].I2tTrip = (POW(Motor[4].MaxDac,2) - POW(Motor[4].I2TSet,2)) * ChTimeAtPeak
Motor[4].IdCmd = 0
